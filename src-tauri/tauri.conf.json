{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UzomaBox Assistant",
  "version": "1.0.0",
  "identifier": "com.uzomabox.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "UzomaBox Assistant",
        "width": 960,
        "height": 600,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
